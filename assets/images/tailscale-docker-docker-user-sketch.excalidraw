    {
      "type": "text",
      "id": "du_rules",
      "x": 324,
      "y": 205,
      "width": 230,
      "height": 150,
      "text": "RETURN  src 10/8\nRETURN  src 172.16/12\nRETURN  src 192.168/16\n\nDENY NEW -> dest 172.16/12\n(after DNAT to container)\n\n100.64/10 is not in the list",
      "originalText": "RETURN  src 10/8\nRETURN  src 172.16/12\nRETURN  src 192.168/16\n\nDENY NEW -> dest 172.16/12\n(after DNAT to container)\n\n100.64/10 is not in the list",
